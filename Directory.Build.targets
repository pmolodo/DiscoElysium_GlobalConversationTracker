<Project>

  <!--
    Two jobs here, both for the projects that build against BepInEx:

      EnsureBepInExCore            fetch what CAN be fetched
      ValidateBepInExReferenceDirs explain what cannot

    A project opts in by declaring what it needs:

      <NeedsBepInExCore>true</NeedsBepInExCore>       BepInEx\core     (BepInEx, Harmony, Il2CppInterop)
      <NeedsBepInExInterop>true</NeedsBepInExInterop> BepInEx\interop  (the generated game assemblies)

    Projects that declare neither - Core, the tests, the offline tools - run
    neither target and need nothing installed, which is what keeps a bare
    'dotnet build' working in a checkout that has no game.

    See Directory.Build.props for where each directory is resolved from, and
    BepInEx.props for the pinned build.
  -->

  <!--
    BepInEx\core is a published archive, the same bytes on every machine, so a
    build that lacks it can simply go and get it rather than telling somebody to
    install a game. Downloaded once per machine into the cache, hash-checked
    against the pin, and unpacked beside the zip.

    Only when the resolved core directory is missing, which is the case exactly
    when no game install supplied one. A machine that has an install, or that
    has done this once already, does nothing here.

    On the hash check: DownloadFile has no integrity option, so the file is
    fetched, hashed and compared, and a mismatch deletes it and fails. Trusting
    an unverified download to become a compile-time reference is how a supply
    chain gets interesting.
  -->
  <Target Name="EnsureBepInExCore" BeforeTargets="ValidateBepInExReferenceDirs;BeforeBuild"
    Condition="'$(NeedsBepInExCore)' == 'true' and '$(BepInExUnpackedDir)' != '' and !Exists('$(BepInExCoreDir)')">

    <Message Importance="high" Text="BepInEx $(BepInExVersion) is not on this machine yet; fetching it into $(BepInExCacheDir)" />

    <DownloadFile SourceUrl="$(BepInExZipUrl)" DestinationFolder="$(BepInExCacheDir)"
      DestinationFileName="$(BepInExZipName)" SkipUnchangedFiles="true" Retries="2">
      <Output TaskParameter="DownloadedFile" PropertyName="_BepInExDownloadedZip" />
    </DownloadFile>

    <GetFileHash Files="$(_BepInExDownloadedZip)" Algorithm="SHA256">
      <Output TaskParameter="Items" ItemName="_BepInExZipHash" />
    </GetFileHash>

    <!-- Delete first, so a bad file cannot be picked up by the next build as though it were cached. -->
    <Delete Files="$(_BepInExDownloadedZip)"
      Condition="'%(_BepInExZipHash.FileHash)' != '$(BepInExZipSha256)'" />
    <Error Condition="'%(_BepInExZipHash.FileHash)' != '$(BepInExZipSha256)'"
      Text="BepInEx $(BepInExVersion) downloaded from $(BepInExZipUrl) does not match its pinned SHA256. Expected $(BepInExZipSha256), got %(_BepInExZipHash.FileHash). The file has been deleted rather than compiled against; check whether the artifact was replaced upstream before touching the pin in BepInEx.props." />

    <Unzip SourceFiles="$(_BepInExDownloadedZip)" DestinationFolder="$(BepInExUnpackedDir)"
      OverwriteReadOnlyFiles="true" />

    <Error Condition="!Exists('$(BepInExCoreDir)')"
      Text="BepInEx $(BepInExVersion) was fetched and unpacked into $(BepInExUnpackedDir) but $(BepInExCoreDir) is still not there, so the archive is not shaped the way this build expects." />
  </Target>

  <!--
    One error message for the three projects that build against a game install,
    so a missing reference fails with one sentence and the whole resolution
    order instead of a wall of MSBuild reference errors.
  -->
  <PropertyGroup>
    <BepInExReferenceHelp>The build looks for a Disco Elysium install in this order: -p:DiscoElysiumDir=&lt;path&gt;, the DEGCT_GAME_DIR environment variable, then whatever '$(RefGameDirCacheFile)' names (written by .\provision-refs.ps1, which is also the only step that can find your Steam copy). Every candidate must actually contain BepInEx: a pristine copy from depot_download.ps1 is the game as Steam ships it and cannot supply these assemblies.</BepInExReferenceHelp>
  </PropertyGroup>

  <Target Name="ValidateBepInExReferenceDirs" BeforeTargets="BeforeBuild"
    Condition="'$(NeedsBepInExCore)' == 'true' or '$(NeedsBepInExInterop)' == 'true'">
    <Error Condition="'$(NeedsBepInExCore)' == 'true' and !Exists('$(BepInExCoreDir)')"
      Text="BepInEx core directory not found: $(BepInExCoreDir). It is normally downloaded automatically, so this means the fetch failed - check the build output above for why, or run .\provision-refs.ps1." />
    <Error Condition="'$(NeedsBepInExInterop)' == 'true' and '$(DiscoElysiumDir)' == ''"
      Text="No Disco Elysium install was found, and $(MSBuildProjectName) references the IL2CPP interop assemblies, which are generated from a real install and cannot be downloaded. $(BepInExReferenceHelp)" />
    <Error Condition="'$(NeedsBepInExInterop)' == 'true' and !Exists('$(BepInExInteropDir)')"
      Text="BepInEx interop directory not found: $(BepInExInteropDir). Those assemblies are generated by BepInEx from the game's own GameAssembly.dll, so install BepInEx 6 (IL2CPP) into that copy and run the game once to produce them." />
  </Target>

</Project>
