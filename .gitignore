.build/
bin/
obj/
*.user

# IDEs
.idea/
.vs/

# OS - specific
.DS_Store

# AI Agent local override files
CLAUDE.local.md
AGENTS.override.md
.claude/settings.local.json

# Throwaway git worktrees created for sub-agent isolation
.claude/worktrees/

# ignore for now - can commit before releasing
uv.lock

# Reference material: copies of the game straight from Steam, AssetRipper
# exports, decompiler output. Tens of gigabytes of someone else's bytes, none of
# it ours to redistribute, and all of it reproducible - a Steam copy from
# depot_download.ps1, the exports from the tools that made them.
.game_reference_copies/


# Added by cargo

/target

# What the measurement runs produced. The measurements THEMSELVES, beside this directory,
# are committed; their results are not - a row is a wall-clock time on one machine, and a
# committed baseline like that goes stale silently. See measurements/README.md.
/measurements/logs/

# Place to stash miscellaneous testing logs we want to keep around
/testing/logs/

# What the analysis tools produce: `outputs/` for their data and `logs/` for their
# transcripts, the same split measurements and testing keep.
#
# Derived from the shipped index and from what a measurement wrote, so a checked-in copy is a
# second copy of something else's shape and goes wrong silently the first time a group grows
# an entry. Regenerate it when something wants it - the generators are committed and the
# results are not, which is the rule measurements/README.md gives for rows.
/analysis/