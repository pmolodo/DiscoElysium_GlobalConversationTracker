<!--
  The one entry point for the whole repo: `dotnet build` and `dotnet test` at
  the repo root pick this up with no arguments, instead of one `cd` per project.

  XML .slnx rather than the classic .sln: it is what `dotnet new sln` produces
  with the SDK this repo builds on (10.0.400), and it can carry the comments
  below. Requires SDK 9.0.200+, Visual Studio 17.14+ or Rider 2024.3+.
-->
<Solution>

    <Folder Name="/src/">
        <Project
            Path="src/GlobalConversationTracker.Core.Tests/GlobalConversationTracker.Core.Tests.csproj" />
        <Project Path="src/GlobalConversationTracker.Core/GlobalConversationTracker.Core.csproj" />
        <!--
      Test-only console app, built because the persistence tests launch it as a
      child process. It is not shipped: only GlobalConversationTracker* files
      from the plugin's own output folder are deployed (see build.ps1).
    -->
        <Project
            Path="src/GlobalConversationTracker.CrashHarness/GlobalConversationTracker.CrashHarness.csproj" />
        <Project
            Path="src/GlobalConversationTracker.Persistence.Tests/GlobalConversationTracker.Persistence.Tests.csproj" />
        <Project
            Path="src/GlobalConversationTracker.Persistence/GlobalConversationTracker.Persistence.csproj" />
        <!--
      Listed so the plugin loads in an IDE, but deliberately NOT built by this
      solution: it references BepInEx and the IL2CPP interop assemblies out of a
      Disco Elysium install, so it cannot build on a machine without one (or in
      a git worktree, where the repo-local reference copy is not checked out).
      Build it through `.\build.ps1`, which resolves that install first.
    -->
        <Project Path="src/GlobalConversationTracker.Plugin/GlobalConversationTracker.Plugin.csproj">
            <Build Project="false" />
        </Project>
        <Project
            Path="src/GlobalConversationTracker.Session.Tests/GlobalConversationTracker.Session.Tests.csproj" />
        <Project
            Path="src/GlobalConversationTracker.Session/GlobalConversationTracker.Session.csproj" />
    </Folder>

    <!--
    Not part of the plugin - standalone offline tools: a decoder for the game's
    Lua save data, the benchmark that times what writing the global state
    costs, and the checker that compares a global state file against the saves
    it should cover. They are in the solution so a repo-root build keeps them
    compiling, and so a repo-root `dotnet test` runs their tests.
  -->
    <Folder Name="/tools/">
        <Project Path="tools/NtwtfDecode.Tests/NtwtfDecode.Tests.csproj" />
        <Project Path="tools/NtwtfDecode/NtwtfDecode.csproj" />
        <Project Path="tools/GlobalStateBenchmark/GlobalStateBenchmark.csproj" />
        <Project Path="tools/GlobalStateCheck.Tests/GlobalStateCheck.Tests.csproj" />
        <Project Path="tools/GlobalStateCheck/GlobalStateCheck.csproj" />
    </Folder>

</Solution>
