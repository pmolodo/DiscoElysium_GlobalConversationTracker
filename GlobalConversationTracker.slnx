<!--
  The one entry point for the whole repo: `dotnet build` and `dotnet test` at
  the repo root pick this up with no arguments, instead of one `cd` per project.

  XML .slnx rather than the classic .sln: it is what `dotnet new sln` produces
  with the SDK this repo builds on (10.0.400), and it can carry the comments
  below. Requires SDK 9.0.200+, Visual Studio 17.14+ or Rider 2024.3+.
-->
<Solution>

    <Folder Name="/src/">
        <Project
            Path="src/GlobalConversationTracker.Core.Tests/GlobalConversationTracker.Core.Tests.csproj" />
        <Project Path="src/GlobalConversationTracker.Core/GlobalConversationTracker.Core.csproj" />
        <!--
      The look-ahead reachability engine and its tests. Like Core, deliberately
      free of Unity, BepInEx and PixelCrushers references: the dialogue graph is
      handed in as plain data, so the search can be tested without the game.
    -->
        <Project
            Path="src/GlobalConversationTracker.LookAhead.Tests/GlobalConversationTracker.LookAhead.Tests.csproj" />
        <!--
      The managed side of the bridge to the Rust look-ahead engine, which draws
      the marker - see de-i5xj. Marshals to a native
      library and back and touches nothing else, so it is testable without the
      game in the same way.
    -->
        <Project
            Path="src/GlobalConversationTracker.Engine/GlobalConversationTracker.Engine.csproj" />
        <!--
      Test-only console app, built because the persistence tests launch it as a
      child process. It is not shipped: only GlobalConversationTracker* files
      from the plugin's own output folder are deployed (see build.ps1).
    -->
        <Project
            Path="src/GlobalConversationTracker.CrashHarness/GlobalConversationTracker.CrashHarness.csproj" />
        <Project
            Path="src/GlobalConversationTracker.Persistence.Tests/GlobalConversationTracker.Persistence.Tests.csproj" />
        <Project
            Path="src/GlobalConversationTracker.Persistence/GlobalConversationTracker.Persistence.csproj" />
        <!--
      Built by this solution like everything else, which it was not until
      2026-08-26: it used to carry `<Build Project="false" />` on the grounds
      that it alone needed a game install to compile against. That stopped being
      true once Persistence and Session gained their own Il2CppInterop.Runtime
      reference - a root build already failed on those two in a checkout with no
      install, so excluding the plugin protected nothing and only hid plugin
      breakage from `dotnet build` and `dotnet test`.

      All three resolve the install the same way, through
      Directory.Build.props. `.\build.ps1` is still the packaging entry point,
      and still the way to cover the one resolution step MSBuild cannot do for
      itself - Steam auto-discovery - but it is no longer the only way to
      compile the plugin.

      `dotnet test` reaches it too, though not through this file: it builds only
      the test projects and what they reference, so
      GlobalConversationTracker.Session.Tests carries a project reference to the
      plugin with ReferenceOutputAssembly="false" - a build-order dependency
      that adds no assembly reference and copies no DLL. That is a build trigger
      and not test coverage, and the comment at the reference says so, since a
      reference nobody explains is one somebody will misread.
    -->
        <Project
            Path="src/GlobalConversationTracker.Plugin/GlobalConversationTracker.Plugin.csproj" />
        <Project
            Path="src/GlobalConversationTracker.Session.Tests/GlobalConversationTracker.Session.Tests.csproj" />
        <Project
            Path="src/GlobalConversationTracker.Session/GlobalConversationTracker.Session.csproj" />
        <!--
      A second BepInEx plugin, and deliberately not part of the mod. It watches
      the mod from outside during an automated in-game run and narrates what the
      game is doing - which conversation opened, and the final text of every
      dialogue option, which is where the look-ahead's asterisk ends up. Logging
      that text is the same evidence a pixel diff would chase, exactly, and it
      says which option was marked.

      It is never shipped and never installed for ordinary play: the harness
      copies it into BepInEx\plugins for the length of a run and removes it
      afterwards. Keeping it out of the mod is the point - the assembly a player
      installs must have no test-only branch in it.
    -->
        <Project
            Path="src/GlobalConversationTracker.TestProbe/GlobalConversationTracker.TestProbe.csproj" />
    </Folder>

    <!--
    Not part of the plugin - standalone offline tools: a decoder for the game's
    Lua save data, the benchmark that times what writing the global state
    costs, and the checker that compares a global state file against the saves
    it should cover. They are in the solution so a repo-root build keeps them
    compiling, and so a repo-root `dotnet test` runs their tests.
  -->
    <Folder Name="/tools/">
        <Project Path="tools/NtwtfDecode.Tests/NtwtfDecode.Tests.csproj" />
        <Project Path="tools/NtwtfDecode/NtwtfDecode.csproj" />
        <!--
      Win32 interop for the PowerShell test harness - finding the game's window
      and sending it keystrokes. Compiled rather than declared inside the
      PowerShell module because Defender blocks a script containing SendInput
      beside window enumeration: the pair reads as a keylogger. Interop belongs
      in a reviewable assembly regardless.
    -->
        <Project Path="tools/GameAutomation/GameAutomation.csproj" />
        <Project Path="tools/GameAutomation.Tests/GameAutomation.Tests.csproj" />
        <!--
      The reader for the Dialogue System database .asset - a Unity-serialized
      YAML document of ~170 MB, streamed at fixed indentation rather than
      parsed - plus the record model for the conversation index it writes.
      A library rather than part of DialogueExtract next door, because
      the look-ahead reads that index back and every other extraction from
      the same asset starts from the same scan.
    -->
        <Project Path="tools/DialogueAsset/DialogueAsset.csproj" />
        <Project Path="tools/DialogueAsset.Tests/DialogueAsset.Tests.csproj" />
        <!--
      The one command over that asset, carrying a subcommand per output.
    -->
        <Project Path="tools/DialogueExtract/DialogueExtract.csproj" />
        <!--
      The console harness that drives the game. Its unit-testable logic lives
      in GameAutomation; the parts that need a running game are behind a verb
      you invoke deliberately, never in dotnet test.
    -->
        <Project Path="tools/GameHarness/GameHarness.csproj" />
        <Project Path="tools/GlobalStateBenchmark/GlobalStateBenchmark.csproj" />
        <Project Path="tools/GlobalStateCheck.Tests/GlobalStateCheck.Tests.csproj" />
        <Project Path="tools/GlobalStateCheck/GlobalStateCheck.csproj" />
    </Folder>

</Solution>
