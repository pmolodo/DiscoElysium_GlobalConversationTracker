<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>NtwtfDecode</RootNamespace>
    <AssemblyName>NtwtfDecode</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <InvariantGlobalization>true</InvariantGlobalization>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <!--
      Persistence owns the save-blob format reader (RawDataReader / LuaTable).
    -->
    <ProjectReference
      Include="..\..\src\UnifiedConversationTracker.Persistence\UnifiedConversationTracker.Persistence.csproj" />
    <ProjectReference
      Include="..\..\src\UnifiedConversationTracker.Persistence.Tests\UnifiedConversationTracker.Persistence.Tests.csproj" />
  </ItemGroup>

</Project>
