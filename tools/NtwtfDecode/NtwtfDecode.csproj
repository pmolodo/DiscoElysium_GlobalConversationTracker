<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>NtwtfDecode</RootNamespace>
    <AssemblyName>NtwtfDecode</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <InvariantGlobalization>true</InvariantGlobalization>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <!--
      The dialogue order the sparse form needs to rebuild Conversation_SimX_*
      variables. Embedded so a conversion cannot half-work: without it the sparse
      reader could not put those variables back. Regenerate with
      generate_simx_order.py when articy_ids_final_cut.json changes.
    -->
    <EmbeddedResource Include="SimXOrder.json" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Persistence owns the save-blob format reader: RawDataParser and the
      IRawDataVisitor it drives. The LuaTable / LuaTableVisitor pair that turns
      a parse into nested tables lives HERE instead, because building a whole
      table is something only the offline tools ever do - the plugin reads what
      it needs as the parse goes past and never holds the blob. That pair sat in
      Persistence.Tests until 2026-08-26, which made a test assembly and its
      xunit package graph a runtime dependency of two shipping console apps;
      moving it to Persistence fixed that, and moving it here puts it with the
      only code that wants it.
    -->
    <ProjectReference
      Include="..\..\src\GlobalConversationTracker.Persistence\GlobalConversationTracker.Persistence.csproj" />
  </ItemGroup>

</Project>
