<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!--
      Nothing here touches the game or BepInEx: it reads the extracted conversation
      index and runs the same engine the mod runs, so it can target whatever is
      convenient rather than the game's runtime.
    -->
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RootNamespace>GlobalConversationTracker.LookAheadOffline</RootNamespace>
    <AssemblyName>LookAheadOffline</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <!--
      The index record model and its JSONL reader live in DialogueAsset, beside
      the extractor that writes the file: one model for the tool that produces
      the index and the tool that consumes it, rather than two that drift.
    -->
    <ProjectReference Include="..\DialogueAsset\DialogueAsset.csproj" />
    <ProjectReference
      Include="..\..\src\GlobalConversationTracker.LookAhead\GlobalConversationTracker.LookAhead.csproj" />
  </ItemGroup>

</Project>
