<Project Sdk="Microsoft.NET.Sdk">

  <!--
    A sibling of NtwtfDecode.Tests rather than more files inside it: this project
    references GlobalStateCheck, which pulls in the plugin's Core and
    Persistence assemblies, and the decoder's tests are deliberately free of
    those. Keeping them apart also keeps the two tools' failures attributable.

    Test framework and versions match every other test project in the repo, so
    the whole repo still runs on one `dotnet test` with one set of packages.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <RootNamespace>GlobalStateCheck.Tests</RootNamespace>
    <AssemblyName>GlobalStateCheck.Tests</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\GlobalStateCheck\GlobalStateCheck.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Compiled in from NtwtfDecode.Tests rather than copied: LuaBlob is the one
      place that writes the binary save format the tests read back, and
      TempDirectory is the one place that builds SaveGames-shaped fixtures. Two
      copies would be two formats waiting to drift.
    -->
    <Compile Include="..\..\src\GlobalConversationTracker.Persistence.Tests\LuaBlob.cs"
      Link="LuaBlob.cs" />
    <Compile Include="..\NtwtfDecode.Tests\TempDirectory.cs" Link="TempDirectory.cs" />
  </ItemGroup>

</Project>
