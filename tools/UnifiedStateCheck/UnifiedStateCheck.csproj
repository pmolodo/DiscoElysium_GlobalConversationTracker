<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>UnifiedStateCheck</RootNamespace>
    <AssemblyName>UnifiedStateCheck</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <InvariantGlobalization>true</InvariantGlobalization>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <!--
      Persistence owns both the unified-state file format - so the checker reads
      exactly what the plugin writes - and the save-blob reader (RawDataParser /
      LuaTable). NtwtfDecode owns finding and unpacking a save on disk
      (SaveBlob); referenced rather than shelled out to so the Conversation
      table is read once, in process, with no JSON round trip.
    -->
    <ProjectReference Include="..\NtwtfDecode\NtwtfDecode.csproj" />
    <ProjectReference Include="..\..\src\UnifiedConversationTracker.Persistence\UnifiedConversationTracker.Persistence.csproj" />
  </ItemGroup>

</Project>
