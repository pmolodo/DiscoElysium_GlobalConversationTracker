<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>UnifiedStateCheck</RootNamespace>
    <AssemblyName>UnifiedStateCheck</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <InvariantGlobalization>true</InvariantGlobalization>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <!--
      Persistence owns the unified-state file format, so
      the checker reads exactly what the plugin writes, and the save-blob format
      reader (RawDataReader / LuaTable).
    -->
    <ProjectReference Include="..\NtwtfDecode\NtwtfDecode.csproj" />
    <ProjectReference Include="..\..\src\UnifiedConversationTracker.Persistence\UnifiedConversationTracker.Persistence.csproj" />
  </ItemGroup>

</Project>
