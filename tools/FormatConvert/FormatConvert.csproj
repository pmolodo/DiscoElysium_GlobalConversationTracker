<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>FormatConvert</RootNamespace>
    <AssemblyName>FormatConvert</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <InvariantGlobalization>true</InvariantGlobalization>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <!--
      Persistence owns the global state reader and its legacy conversion; NtwtfDecode
      owns the Lua-side formats and the version each of them is at. This tool is the one
      place that has to know about both, because a caller pointing it at a file does not
      say which half of the world the file came from - see Formats.Detect.
    -->
    <ProjectReference
      Include="..\..\src\GlobalConversationTracker.Persistence\GlobalConversationTracker.Persistence.csproj" />
    <ProjectReference Include="..\NtwtfDecode\NtwtfDecode.csproj" />
  </ItemGroup>

</Project>
