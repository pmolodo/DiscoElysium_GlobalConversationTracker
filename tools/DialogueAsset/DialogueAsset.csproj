<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!--
      A library, not a tool: the .asset reader is shared by the DialogueExtract
      CLI and by anything else that has to read the 170 MB Dialogue System
      database. The index it produces is read back by the Rust engine, which is
      where the look-ahead lives. Nothing here touches the game or BepInEx - it
      reads a text file - so it targets whatever is convenient rather than the
      game's runtime.
    -->
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <RootNamespace>GlobalConversationTracker.DialogueAsset</RootNamespace>
    <AssemblyName>DialogueAsset</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <!--
      For ConversationHasher, which reduces a conversation to the string the
      plugin compares its live database against. The extractor and the plugin
      are the two writers of that reduction and there must only be one routine,
      so it lives in the assembly the plugin already compiles in and this
      references it. Nothing here calls the native library that assembly also
      declares.
    -->
    <ProjectReference
      Include="..\..\src\GlobalConversationTracker.Engine\GlobalConversationTracker.Engine.csproj" />

    <!--
      For SparseOrder, and for the same reason as the reference above. The worst-case
      global state is a second writer of the format GlobalStateJson writes, and its entry
      sets are run-encoded; two implementations of a run encoding are two that agree until
      they do not. One routine, in the assembly the plugin already compiles in.
    -->
    <ProjectReference
      Include="..\..\src\GlobalConversationTracker.Core\GlobalConversationTracker.Core.csproj" />
  </ItemGroup>

</Project>
