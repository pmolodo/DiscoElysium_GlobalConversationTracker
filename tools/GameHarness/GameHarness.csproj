<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- net6.0, matching GameAutomation, which it is a front end for. -->
    <OutputType>Exe</OutputType>
    <TargetFramework>net6.0-windows</TargetFramework>
    <CheckEolTargetFramework>false</CheckEolTargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <RootNamespace>GlobalConversationTracker.Harness</RootNamespace>
    <AssemblyName>GameHarness</AssemblyName>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\GameAutomation\GameAutomation.csproj" />
    <!-- The header every fixture this reads carries, and the check that refuses one that
         says it is something else. -->
    <ProjectReference
      Include="..\..\src\GlobalConversationTracker.Core\GlobalConversationTracker.Core.csproj" />
  </ItemGroup>

</Project>
