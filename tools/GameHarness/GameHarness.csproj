<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- net6.0, matching GameAutomation, which it is a front end for. -->
    <OutputType>Exe</OutputType>
    <TargetFramework>net6.0-windows</TargetFramework>
    <CheckEolTargetFramework>false</CheckEolTargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <RootNamespace>GlobalConversationTracker.Harness</RootNamespace>
    <AssemblyName>GameHarness</AssemblyName>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\GameAutomation\GameAutomation.csproj" />
  </ItemGroup>

  <!-- The harness invokes the net10 decoder as a child process. -->
  <Target Name="BuildNtwtfDecode" BeforeTargets="Build">
    <MSBuild
      Projects="..\NtwtfDecode\NtwtfDecode.csproj"
      Targets="Build"
      Properties="Configuration=$(Configuration)" />
  </Target>

</Project>
