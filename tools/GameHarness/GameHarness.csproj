<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!--
      net48 because it references GameAutomation, which needs System.Drawing from
      the framework rather than a NuGet package.
    -->
    <OutputType>Exe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <RootNamespace>GlobalConversationTracker.Harness</RootNamespace>
    <AssemblyName>GameHarness</AssemblyName>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\GameAutomation\GameAutomation.csproj" />
  </ItemGroup>

  <!-- The net48 harness invokes the net10 decoder as a child process. -->
  <Target Name="BuildNtwtfDecode" BeforeTargets="Build">
    <MSBuild
      Projects="..\NtwtfDecode\NtwtfDecode.csproj"
      Targets="Build"
      Properties="Configuration=$(Configuration)" />
  </Target>

</Project>
