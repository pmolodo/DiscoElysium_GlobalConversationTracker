<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- BepInEx 6.0.0-be.688 runs IL2CPP plugins on CoreCLR .NET 6. -->
    <TargetFramework>net6.0</TargetFramework>
    <AssemblyName>UnifiedConversationTracker</AssemblyName>
    <RootNamespace>UnifiedConversationTracker</RootNamespace>
    <Version>0.1.0</Version>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <Deterministic>true</Deterministic>
    <DebugType>portable</DebugType>
    <!-- BepInEx resolves plugin dependencies itself; a deps.json only confuses it. -->
    <GenerateDependencyFile>false</GenerateDependencyFile>
  </PropertyGroup>

  <!--
    Location of the Disco Elysium - Final Cut install whose BepInEx installation
    supplies the reference assemblies. Override with either the DISCO_ELYSIUM_DIR
    environment variable or -p:DiscoElysiumDir=<path>.
  -->
  <PropertyGroup>
    <DiscoElysiumDir Condition="'$(DiscoElysiumDir)' == '' and '$(DISCO_ELYSIUM_DIR)' != ''">$(DISCO_ELYSIUM_DIR)</DiscoElysiumDir>
    <DiscoElysiumDir Condition="'$(DiscoElysiumDir)' == ''">$(MSBuildThisFileDirectory)..\..\Steam Install - Unaltered\Disco Elysium</DiscoElysiumDir>
    <BepInExCoreDir>$(DiscoElysiumDir)\BepInEx\core\</BepInExCoreDir>
    <BepInExInteropDir>$(DiscoElysiumDir)\BepInEx\interop\</BepInExInteropDir>
  </PropertyGroup>

  <Target Name="ValidateBepInExReferenceDirs" BeforeTargets="BeforeBuild">
    <Error Condition="!Exists('$(BepInExCoreDir)')"
           Text="BepInEx core directory not found: $(BepInExCoreDir). Set DISCO_ELYSIUM_DIR or pass -p:DiscoElysiumDir=&lt;game dir&gt;." />
    <Error Condition="!Exists('$(BepInExInteropDir)')"
           Text="BepInEx interop directory not found: $(BepInExInteropDir). Run the game once with BepInEx installed to generate the IL2CPP interop assemblies." />
  </Target>

  <!-- BepInEx / Il2CppInterop framework assemblies. -->
  <ItemGroup>
    <Reference Include="BepInEx.Core" HintPath="$(BepInExCoreDir)BepInEx.Core.dll" Private="false" />
    <Reference Include="BepInEx.Unity.Common" HintPath="$(BepInExCoreDir)BepInEx.Unity.Common.dll" Private="false" />
    <Reference Include="BepInEx.Unity.IL2CPP" HintPath="$(BepInExCoreDir)BepInEx.Unity.IL2CPP.dll" Private="false" />
    <Reference Include="Il2CppInterop.Runtime" HintPath="$(BepInExCoreDir)Il2CppInterop.Runtime.dll" Private="false" />
    <Reference Include="0Harmony" HintPath="$(BepInExCoreDir)0Harmony.dll" Private="false" />
  </ItemGroup>

  <!-- Game assemblies, as generated into BepInEx\interop by the IL2CPP interop step. -->
  <ItemGroup>
    <Reference Include="Assembly-CSharp" HintPath="$(BepInExInteropDir)Assembly-CSharp.dll" Private="false" />
    <Reference Include="DialogueSystem" HintPath="$(BepInExInteropDir)DialogueSystem.dll" Private="false" />
    <Reference Include="PixelCrushers" HintPath="$(BepInExInteropDir)PixelCrushers.dll" Private="false" />
    <Reference Include="Il2Cppmscorlib" HintPath="$(BepInExInteropDir)Il2Cppmscorlib.dll" Private="false" />
    <Reference Include="Il2CppSystem" HintPath="$(BepInExInteropDir)Il2CppSystem.dll" Private="false" />
    <Reference Include="Il2CppSystem.Core" HintPath="$(BepInExInteropDir)Il2CppSystem.Core.dll" Private="false" />
    <Reference Include="UnityEngine" HintPath="$(BepInExInteropDir)UnityEngine.dll" Private="false" />
    <Reference Include="UnityEngine.CoreModule" HintPath="$(BepInExInteropDir)UnityEngine.CoreModule.dll" Private="false" />
  </ItemGroup>

</Project>
