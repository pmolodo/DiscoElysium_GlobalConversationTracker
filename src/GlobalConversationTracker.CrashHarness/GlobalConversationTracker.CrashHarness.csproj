<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!--
      Test-only console app. It exists so the crash-point tests can kill a real
      process mid-save instead of asserting that a simulated failure was
      "handled". net6.0 to match the project under test (and the runtime BepInEx
      v6 IL2CPP actually uses).
    -->
    <OutputType>Exe</OutputType>
    <TargetFramework>net6.0</TargetFramework>
    <!-- net6.0 is chosen to match the game's runtime, not for support status. -->
    <CheckEolTargetFramework>false</CheckEolTargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <IsPackable>false</IsPackable>
    <RootNamespace>GlobalConversationTracker.CrashHarness</RootNamespace>
    <AssemblyName>GlobalConversationTracker.CrashHarness</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference
      Include="..\GlobalConversationTracker.Persistence\GlobalConversationTracker.Persistence.csproj" />
  </ItemGroup>

</Project>
