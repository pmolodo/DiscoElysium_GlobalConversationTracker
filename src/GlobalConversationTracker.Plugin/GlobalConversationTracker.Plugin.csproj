<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <!-- BepInEx 6.0.0-be.688 runs IL2CPP plugins on CoreCLR .NET 6. -->
        <TargetFramework>net6.0</TargetFramework>
        <AssemblyName>GlobalConversationTracker</AssemblyName>
        <RootNamespace>GlobalConversationTracker</RootNamespace>
        <Version>0.1.0</Version>
        <LangVersion>latest</LangVersion>
        <Nullable>enable</Nullable>
        <ImplicitUsings>disable</ImplicitUsings>
        <!-- For the Persistence layer's Il2CppArrayExtensions, compiled in below. -->
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <Deterministic>true</Deterministic>
        <DebugType>portable</DebugType>
        <!--
          Both on, matching every other project in the repo. Doc generation is what
          makes the compiler check <see cref="..."/> targets at all: without it a cref
          pointing at a deleted type compiles clean, which is how a dangling one here
          once survived its class's deletion through a 0-warning build. The generated
          .xml is a by-product nobody ships - only the DLL is deployed.
        -->
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
        <!-- BepInEx resolves plugin dependencies itself; a deps.json only confuses it. -->
        <GenerateDependencyFile>false</GenerateDependencyFile>
        <!--
          So Google.Protobuf.dll lands beside the plugin. A library project leaves package
          assemblies in the package folder by default, which is right for something another
          project will reference and wrong for something BepInEx loads from a directory: it
          resolves a plugin's dependencies out of the plugin's own folder, so an assembly
          that is not there is not found.
        -->
        <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    </PropertyGroup>

    <!--
    The wire's types, generated here as well as in the Engine project, because this
    assembly compiles that project's SOURCES rather than referencing it - and the
    generated file lands in obj\, which the Compile globs below deliberately exclude.
    Generating it again costs a protoc invocation; sharing one copy would mean a
    generated file checked in or globbed out of another project's obj\, and both of
    those are a build that reads another build's leavings.

    THIS IS WHERE THE ONE-FILE INSTALL ENDS, and the comment below about compiling
    the layers in should be read with that in mind: the four layers still merge into
    one assembly, but the payload is now that assembly plus Google.Protobuf.dll. It
    is the first shipped file not named for this project, which is why
    build-support.psm1 had to be told about it by name.
  -->
    <ItemGroup>
        <PackageReference Include="Google.Protobuf" Version="$(GoogleProtobufVersion)" />
        <PackageReference Include="Grpc.Tools" Version="$(GrpcToolsVersion)" PrivateAssets="all" />
        <Protobuf Include="$(MSBuildThisFileDirectory)..\..\proto\engine.proto"
            ProtoRoot="$(MSBuildThisFileDirectory)..\..\proto" GrpcServices="None" />
    </ItemGroup>

    <!--
    The mod's own layers, compiled INTO this assembly rather than referenced as
    projects, so all of the mod's own code is one DLL.

    Why source and not a ProjectReference: a reference would put
    GlobalConversationTracker.Core/.Persistence/.Session.dll next to the plugin and
    all four would have to be installed together, since BepInEx resolves a plugin's
    dependencies out of the plugin's own folder - three extra files to lose, to ship
    a stale copy of, or to leave behind on an uninstall. Merging them after the fact
    (ILRepack and friends) would need a NuGet tool of its own; compiling the sources
    in needs nothing, and the layering it would enforce is enforced by the projects
    themselves anyway.

    THAT ARGUMENT IS ABOUT THE MOD'S OWN LAYERS and is unaffected by the protobuf
    runtime above it: Google.Protobuf is a third-party assembly with its own
    identity and its own licence, so it travels as itself rather than being folded
    in. Every file the install writes is still one predicate's answer - see
    Get-PluginPayloadFile - which is what keeps an uninstall able to remove exactly
    what a deploy wrote.

    The three projects still exist, still build on their own and are still what the
    test projects reference; this only changes what ships. Their namespaces already
    nest under this assembly's own, so nothing about the code changes by moving in.
  -->
    <ItemGroup>
        <Compile Include="..\GlobalConversationTracker.Core\**\*.cs"
            Exclude="..\GlobalConversationTracker.Core\bin\**;..\GlobalConversationTracker.Core\obj\**"
            LinkBase="GlobalConversationTracker.Core" />
        <Compile Include="..\GlobalConversationTracker.Persistence\**\*.cs"
            Exclude="..\GlobalConversationTracker.Persistence\bin\**;..\GlobalConversationTracker.Persistence\obj\**"
            LinkBase="GlobalConversationTracker.Persistence" />
        <Compile Include="..\GlobalConversationTracker.Session\**\*.cs"
            Exclude="..\GlobalConversationTracker.Session\bin\**;..\GlobalConversationTracker.Session\obj\**"
            LinkBase="GlobalConversationTracker.Session" />
        <!--
      The managed side of the bridge to the Rust look-ahead - see de-i5xj. Compiled
      in for the same reason as the rest, and with one extra benefit: EngineHost
      then lives in THIS assembly, and it looks for the engine executable beside the
      assembly it is in. That is the plugin's own folder, which is exactly where the
      engine is deployed. (It used to be a DllImport and the same argument applied
      to the loader's probing path; de-bnjy.1 changed the mechanism, not the reason.)
    -->
        <Compile Include="..\GlobalConversationTracker.Engine\**\*.cs"
            Exclude="..\GlobalConversationTracker.Engine\bin\**;..\GlobalConversationTracker.Engine\obj\**"
            LinkBase="GlobalConversationTracker.Engine" />
    </ItemGroup>

    <!--
    The Rust look-ahead engine, copied in under a name the deployment already
    carries: Get-PluginPayloadFile takes $AssemblyName* out of this folder, so
    calling it GlobalConversationTracker.Native.exe means deploy.ps1, the release
    packaging and the uninstaller all handle it without being told about it.

    AN EXECUTABLE AND NOT A LIBRARY SINCE de-bnjy.1. The plugin used to DllImport a
    cdylib, which meant every way the engine could fail was a way the game could
    fail. It now runs as a child process and is spoken to over a pipe, so what is
    deployed is the thing that gets spawned.

    Conditional on the file existing, because a C#-only build must still work - the
    Rust side needs `cargo build` and a contributor who has not run it should get a
    plugin that logs the bridge as unavailable, not a build error.
  -->
    <Target Name="CopyNativeLookAhead" AfterTargets="Build">
        <PropertyGroup>
            <NativeLookAheadRelease>$(MSBuildThisFileDirectory)..\..\target\release\</NativeLookAheadRelease>
            <NativeLookAheadDebug>$(MSBuildThisFileDirectory)..\..\target\debug\</NativeLookAheadDebug>
            <NativeLookAheadDir Condition="Exists('$(NativeLookAheadRelease)gct-engine-host.exe')">$(NativeLookAheadRelease)</NativeLookAheadDir>
            <NativeLookAheadDir Condition="'$(NativeLookAheadDir)' == '' And Exists('$(NativeLookAheadDebug)gct-engine-host.exe')">$(NativeLookAheadDebug)</NativeLookAheadDir>
        </PropertyGroup>
        <Copy Condition="'$(NativeLookAheadDir)' != ''"
            SourceFiles="$(NativeLookAheadDir)gct-engine-host.exe"
            DestinationFiles="$(OutDir)GlobalConversationTracker.Native.exe"
            SkipUnchangedFiles="true" />
        <!--
        And the stamp beside it, saying which source the engine was built from. Copied
        as a pair, and never one without the other: a run compares the stamp against the
        tree it is running from and refuses when they differ, so a stamp left behind from
        an older engine would be worse than none. See build.rs, which writes one stamp
        per profile directory covering everything built from that tree - so it is named
        for the crate rather than for either artefact.
      -->
        <PropertyGroup>
            <NativeLookAheadStamp>$(NativeLookAheadDir)lookahead_engine.built.json</NativeLookAheadStamp>
        </PropertyGroup>
        <Copy Condition="'$(NativeLookAheadDir)' != '' And Exists('$(NativeLookAheadStamp)')"
            SourceFiles="$(NativeLookAheadStamp)"
            DestinationFiles="$(OutDir)GlobalConversationTracker.Native.built.json"
            SkipUnchangedFiles="true" />
        <Delete Condition="'$(NativeLookAheadDir)' != '' And !Exists('$(NativeLookAheadStamp)')"
            Files="$(OutDir)GlobalConversationTracker.Native.built.json" />
        <Message Condition="'$(NativeLookAheadDir)' == ''" Importance="high"
            Text="No Rust look-ahead engine found; the plugin will report the bridge as unavailable. Run: cargo build --release" />
        <!--
        And the cdylib this used to deploy, swept up. The crate no longer builds one and
        src/ffi.rs is gone (de-bnjy.1.1.4), but the payload predicate takes every
        GlobalConversationTracker*.dll out of this folder - so one an earlier build left
        here would still be shipped, and a thirty-megabyte library nobody opens is the
        kind of thing that goes unnoticed for a year. Harmless once every output folder
        has been rebuilt; cheap enough to leave.
      -->
        <Delete Files="$(OutDir)GlobalConversationTracker.Native.dll" />
    </Target>

    <!--
    The state library, which is a different kind of thing from the engine beside it.

    NOT CONDITIONAL, and not renamed. Not conditional because it is the one reader and
    writer of the mod's own state file - there is no C# copy of that format - so a plugin
    built without it is a plugin that cannot track anything, which is a build error rather
    than a capability quietly missing. Not renamed because a DllImport resolves by the name
    in the attribute and the resolver beside GlobalStateNative looks for that name; the
    payload predicate learns it instead, the way it already learns Google.Protobuf's.

    Copied here rather than arriving with the Persistence project, because the plugin
    compiles that project's SOURCE rather than referencing it - see above - so nothing of
    its build output travels.
  -->
    <Target Name="CopyStateLibrary" AfterTargets="Build">
        <PropertyGroup>
            <StateLibraryName>gct_state.dll</StateLibraryName>
            <StateLibraryRelease>$(MSBuildThisFileDirectory)..\..\target\release\$(StateLibraryName)</StateLibraryRelease>
            <StateLibraryDebug>$(MSBuildThisFileDirectory)..\..\target\debug\$(StateLibraryName)</StateLibraryDebug>
            <StateLibrary Condition="Exists('$(StateLibraryRelease)')">$(StateLibraryRelease)</StateLibrary>
            <StateLibrary
                Condition="'$(StateLibrary)' == '' And Exists('$(StateLibraryDebug)')">$(StateLibraryDebug)</StateLibrary>
        </PropertyGroup>
        <Error Condition="'$(StateLibrary)' == ''"
            Text="The state library is not built, and it is what reads and writes the mod's own state file. Build it first:%0A  cargo build --release -p gct_state" />
        <Copy SourceFiles="$(StateLibrary)" DestinationFolder="$(OutDir)"
            SkipUnchangedFiles="true" />
    </Target>

    <!--
    The conversation index the look-ahead reads, trimmed to what a crawl consults - 47.7 MB
    down to 14.3 MB, and about 1.2 MB inside a release archive. Named to match the payload
    predicate for the same reason the engine executable is, so nothing about deployment has
    to learn it exists.

    Conditional again: a checkout without the extracted game data still builds, and the
    plugin says at load that it has no index to open rather than failing here. The
    extractor's "shipped-index" command produces it; the message below spells out the
    invocation, which an XML comment cannot.
  -->
    <Target Name="CopyConversationIndex" AfterTargets="Build">
        <PropertyGroup>
            <ConversationIndexSource>$(MSBuildThisFileDirectory)..\..\.game_reference_copies\derived\conversation_index.trimmed.jsonl</ConversationIndexSource>
        </PropertyGroup>
        <Copy Condition="Exists('$(ConversationIndexSource)')"
            SourceFiles="$(ConversationIndexSource)"
            DestinationFiles="$(OutDir)GlobalConversationTracker.Index.jsonl"
            SkipUnchangedFiles="true" />
        <Message Condition="!Exists('$(ConversationIndexSource)')" Importance="high"
            Text="No trimmed conversation index found; the look-ahead will have nothing to open. Run: dotnet run --project tools/DialogueExtract -- shipped-index" />
    </Target>

    <!--
    The database's variable table, 851 KB, so the engine can tell a counter from a flag.
    Without it a dialogue variable the game will not answer reads Unknown; with it the value
    the database declares is used instead, which is what an unwritten variable actually is
    and the only answer that keeps an ordering comparison over a counter decidable. Only 142
    of the 10,645 are numbers, so this is worth about one variable in seventy-five - and
    those are exactly the ones the counting guards ask about.

    Renamed on the way in for the same reason the index and the engine are: the
    deployment predicate takes $AssemblyName*, so a file called variables.jsonl would be
    built, ignored, and never noticed missing.
  -->
    <Target Name="CopyVariableTable" AfterTargets="Build">
        <PropertyGroup>
            <VariableTableSource>$(MSBuildThisFileDirectory)..\..\.game_reference_copies\derived\variables.jsonl</VariableTableSource>
        </PropertyGroup>
        <Copy Condition="Exists('$(VariableTableSource)')"
            SourceFiles="$(VariableTableSource)"
            DestinationFiles="$(OutDir)GlobalConversationTracker.Variables.jsonl"
            SkipUnchangedFiles="true" />
        <Message Condition="!Exists('$(VariableTableSource)')" Importance="high"
            Text="No variable table found; the look-ahead will answer unset variables less precisely. Run: dotnet run --project tools/DialogueExtract -- variables" />
    </Target>

    <!--
    This project references assemblies out of a Disco Elysium install. Saying so here
    is the whole of it: Directory.Build.props resolves the install and
    Directory.Build.targets does the checking, for every project that needs one.
  -->
    <PropertyGroup>
        <NeedsBepInExCore>true</NeedsBepInExCore>
        <NeedsBepInExInterop>true</NeedsBepInExInterop>
    </PropertyGroup>

    <!-- BepInEx / Il2CppInterop framework assemblies. -->
    <ItemGroup>
        <Reference Include="BepInEx.Core" HintPath="$(BepInExCoreDir)BepInEx.Core.dll"
            Private="false" />
        <Reference Include="BepInEx.Unity.Common"
            HintPath="$(BepInExCoreDir)BepInEx.Unity.Common.dll" Private="false" />
        <Reference Include="BepInEx.Unity.IL2CPP"
            HintPath="$(BepInExCoreDir)BepInEx.Unity.IL2CPP.dll" Private="false" />
        <Reference Include="Il2CppInterop.Runtime"
            HintPath="$(BepInExCoreDir)Il2CppInterop.Runtime.dll" Private="false" />
        <Reference Include="0Harmony" HintPath="$(BepInExCoreDir)0Harmony.dll" Private="false" />
    </ItemGroup>

    <!-- Game assemblies, as generated into BepInEx\interop by the IL2CPP interop step. -->
    <ItemGroup>
        <Reference Include="Assembly-CSharp" HintPath="$(BepInExInteropDir)Assembly-CSharp.dll"
            Private="false" />
        <Reference Include="DialogueSystem" HintPath="$(BepInExInteropDir)DialogueSystem.dll"
            Private="false" />
        <Reference Include="PixelCrushers" HintPath="$(BepInExInteropDir)PixelCrushers.dll"
            Private="false" />
        <Reference Include="Il2Cppmscorlib" HintPath="$(BepInExInteropDir)Il2Cppmscorlib.dll"
            Private="false" />
        <Reference Include="Il2CppSystem" HintPath="$(BepInExInteropDir)Il2CppSystem.dll"
            Private="false" />
        <Reference Include="Il2CppSystem.Core" HintPath="$(BepInExInteropDir)Il2CppSystem.Core.dll"
            Private="false" />
        <Reference Include="UnityEngine" HintPath="$(BepInExInteropDir)UnityEngine.dll"
            Private="false" />
        <Reference Include="UnityEngine.CoreModule"
            HintPath="$(BepInExInteropDir)UnityEngine.CoreModule.dll" Private="false" />
        <!-- TextMeshProUGUI, the type of the HUD text the mod adds and of the one it copies. -->
        <Reference Include="Unity.TextMeshPro" HintPath="$(BepInExInteropDir)Unity.TextMeshPro.dll"
            Private="false" />
        <!-- Graphic, TextMeshProUGUI's base: colour and raycastTarget are declared there. -->
        <Reference Include="UnityEngine.UI" HintPath="$(BepInExInteropDir)UnityEngine.UI.dll"
            Private="false" />
        <!-- ImageConversion.LoadImage, which decodes the embedded icon into a texture. -->
        <Reference Include="UnityEngine.ImageConversionModule"
            HintPath="$(BepInExInteropDir)UnityEngine.ImageConversionModule.dll" Private="false" />
    </ItemGroup>

    <!--
    The two count icons: a speech bubble for the current save, a globe for all saves.
    None of the game's fonts carry a glyph above U+FF70 and its TMP sprite asset is
    TextMesh Pro's 14-smiley EmojiOne sample, so emoji characters would draw as
    nothing; the icons ship as textures instead. Embedded rather than deployed beside
    the DLL so there is one file to install and nothing to lose.
  -->
    <ItemGroup>
        <EmbeddedResource Include="Resources\*.png" />
    </ItemGroup>

</Project>
