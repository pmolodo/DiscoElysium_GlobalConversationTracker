<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <!-- BepInEx 6.0.0-be.688 runs IL2CPP plugins on CoreCLR .NET 6. -->
        <TargetFramework>net6.0</TargetFramework>
        <AssemblyName>GlobalConversationTracker</AssemblyName>
        <RootNamespace>GlobalConversationTracker</RootNamespace>
        <Version>0.1.0</Version>
        <LangVersion>latest</LangVersion>
        <Nullable>enable</Nullable>
        <ImplicitUsings>disable</ImplicitUsings>
        <!-- For the Persistence layer's Il2CppArrayExtensions, compiled in below. -->
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <Deterministic>true</Deterministic>
        <DebugType>portable</DebugType>
        <!--
          Both on, matching every other project in the repo. Doc generation is what
          makes the compiler check <see cref="..."/> targets at all: without it a cref
          pointing at a deleted type compiles clean, which is how a dangling one here
          once survived its class's deletion through a 0-warning build. The generated
          .xml is a by-product nobody ships - only the DLL is deployed.
        -->
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
        <!-- BepInEx resolves plugin dependencies itself; a deps.json only confuses it. -->
        <GenerateDependencyFile>false</GenerateDependencyFile>
    </PropertyGroup>

    <!--
    The mod's own layers, compiled INTO this assembly rather than referenced as
    projects, so the build output is one DLL and an install is one file.

    Why source and not a ProjectReference: a reference would put
    GlobalConversationTracker.Core/.Persistence/.Session.dll next to the plugin and
    all four would have to be installed together, since BepInEx resolves a plugin's
    dependencies out of the plugin's own folder - three extra files to lose, to ship
    a stale copy of, or to leave behind on an uninstall. Merging them after the fact
    (ILRepack and friends) would need a NuGet tool in a build that otherwise has zero
    package references; compiling the sources in needs nothing, and the layering it
    would enforce is enforced by the projects themselves anyway.

    The three projects still exist, still build on their own and are still what the
    test projects reference; this only changes what ships. Their namespaces already
    nest under this assembly's own, so nothing about the code changes by moving in.
  -->
    <ItemGroup>
        <Compile Include="..\GlobalConversationTracker.Core\**\*.cs"
            Exclude="..\GlobalConversationTracker.Core\bin\**;..\GlobalConversationTracker.Core\obj\**"
            LinkBase="GlobalConversationTracker.Core" />
        <Compile Include="..\GlobalConversationTracker.Persistence\**\*.cs"
            Exclude="..\GlobalConversationTracker.Persistence\bin\**;..\GlobalConversationTracker.Persistence\obj\**"
            LinkBase="GlobalConversationTracker.Persistence" />
        <Compile Include="..\GlobalConversationTracker.Session\**\*.cs"
            Exclude="..\GlobalConversationTracker.Session\bin\**;..\GlobalConversationTracker.Session\obj\**"
            LinkBase="GlobalConversationTracker.Session" />
    </ItemGroup>

    <!--
    This project references assemblies out of a Disco Elysium install. Saying so here
    is the whole of it: Directory.Build.props resolves the install and
    Directory.Build.targets does the checking, for every project that needs one.
  -->
    <PropertyGroup>
        <NeedsBepInExCore>true</NeedsBepInExCore>
        <NeedsBepInExInterop>true</NeedsBepInExInterop>
    </PropertyGroup>

    <!-- BepInEx / Il2CppInterop framework assemblies. -->
    <ItemGroup>
        <Reference Include="BepInEx.Core" HintPath="$(BepInExCoreDir)BepInEx.Core.dll"
            Private="false" />
        <Reference Include="BepInEx.Unity.Common"
            HintPath="$(BepInExCoreDir)BepInEx.Unity.Common.dll" Private="false" />
        <Reference Include="BepInEx.Unity.IL2CPP"
            HintPath="$(BepInExCoreDir)BepInEx.Unity.IL2CPP.dll" Private="false" />
        <Reference Include="Il2CppInterop.Runtime"
            HintPath="$(BepInExCoreDir)Il2CppInterop.Runtime.dll" Private="false" />
        <Reference Include="0Harmony" HintPath="$(BepInExCoreDir)0Harmony.dll" Private="false" />
    </ItemGroup>

    <!-- Game assemblies, as generated into BepInEx\interop by the IL2CPP interop step. -->
    <ItemGroup>
        <Reference Include="Assembly-CSharp" HintPath="$(BepInExInteropDir)Assembly-CSharp.dll"
            Private="false" />
        <Reference Include="DialogueSystem" HintPath="$(BepInExInteropDir)DialogueSystem.dll"
            Private="false" />
        <Reference Include="PixelCrushers" HintPath="$(BepInExInteropDir)PixelCrushers.dll"
            Private="false" />
        <Reference Include="Il2Cppmscorlib" HintPath="$(BepInExInteropDir)Il2Cppmscorlib.dll"
            Private="false" />
        <Reference Include="Il2CppSystem" HintPath="$(BepInExInteropDir)Il2CppSystem.dll"
            Private="false" />
        <Reference Include="Il2CppSystem.Core" HintPath="$(BepInExInteropDir)Il2CppSystem.Core.dll"
            Private="false" />
        <Reference Include="UnityEngine" HintPath="$(BepInExInteropDir)UnityEngine.dll"
            Private="false" />
        <Reference Include="UnityEngine.CoreModule"
            HintPath="$(BepInExInteropDir)UnityEngine.CoreModule.dll" Private="false" />
        <!-- TextMeshProUGUI, the type of the HUD text the mod adds and of the one it copies. -->
        <Reference Include="Unity.TextMeshPro" HintPath="$(BepInExInteropDir)Unity.TextMeshPro.dll"
            Private="false" />
        <!-- Graphic, TextMeshProUGUI's base: colour and raycastTarget are declared there. -->
        <Reference Include="UnityEngine.UI" HintPath="$(BepInExInteropDir)UnityEngine.UI.dll"
            Private="false" />
        <!-- ImageConversion.LoadImage, which decodes the embedded icon into a texture. -->
        <Reference Include="UnityEngine.ImageConversionModule"
            HintPath="$(BepInExInteropDir)UnityEngine.ImageConversionModule.dll" Private="false" />
    </ItemGroup>

    <!--
    The two count icons: a speech bubble for the current save, a globe for all saves.
    None of the game's fonts carry a glyph above U+FF70 and its TMP sprite asset is
    TextMesh Pro's 14-smiley EmojiOne sample, so emoji characters would draw as
    nothing; the icons ship as textures instead. Embedded rather than deployed beside
    the DLL so there is one file to install and nothing to lose.
  -->
    <ItemGroup>
        <EmbeddedResource Include="Resources\*.png" />
    </ItemGroup>

</Project>
