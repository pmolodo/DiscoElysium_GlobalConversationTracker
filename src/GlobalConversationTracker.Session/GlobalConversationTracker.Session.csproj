<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!--
      net6.0 to match Persistence (and the CoreCLR runtime BepInEx v6 gives an
      IL2CPP plugin). This project is the layer that decides WHEN the global
      state is read, seeded and written; it deliberately knows nothing about
      Unity, BepInEx or the Dialogue System, so it stays unit testable without
      the game. The plugin supplies the game-facing pieces.
    -->
    <TargetFramework>net6.0</TargetFramework>
    <!-- net6.0 is chosen to match the game's runtime, not for support status. -->
    <CheckEolTargetFramework>false</CheckEolTargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <RootNamespace>GlobalConversationTracker.Session</RootNamespace>
    <AssemblyName>GlobalConversationTracker.Session</AssemblyName>
  </PropertyGroup>


  <!--
    This project references assemblies out of a Disco Elysium install. Saying so
    here is the whole of it: Directory.Build.props resolves the install and
    Directory.Build.targets does the checking, for every project that needs one.
  -->
  <PropertyGroup>
    <NeedsBepInExCore>true</NeedsBepInExCore>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="Il2CppInterop.Runtime" HintPath="$(BepInExCoreDir)Il2CppInterop.Runtime.dll"
      Private="false" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference
      Include="..\GlobalConversationTracker.Core\GlobalConversationTracker.Core.csproj" />
    <ProjectReference
      Include="..\GlobalConversationTracker.Persistence\GlobalConversationTracker.Persistence.csproj" />
  </ItemGroup>

</Project>
