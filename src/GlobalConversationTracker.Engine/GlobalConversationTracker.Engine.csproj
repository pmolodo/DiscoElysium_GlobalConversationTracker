<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!--
      The managed side of the bridge to the Rust look-ahead engine - see de-i5xj.
      Nothing here touches Unity, BepInEx or PixelCrushers; it marshals to a
      native library and back, and builds the JSON that crosses, so all of it can
      be tested without the game.

      net6.0, and NOT netstandard2.0 as this began, for the reason the Persistence
      project gives: the request and the questions travel as JSON, and
      System.Text.Json is in-box on net6.0 while on netstandard2.0 it is a NuGet
      package and a System.Memory / System.Buffers dependency chain that would
      then have to ship beside the plugin. BepInEx v6 IL2CPP runs the plugin on
      net6.0 / CoreCLR and the test project is net10.0, so both consumers take a
      net6.0 assembly without complaint.
    -->
    <TargetFramework>net6.0</TargetFramework>
    <!-- net6.0 is chosen to match the game's runtime, not for support status. -->
    <CheckEolTargetFramework>false</CheckEolTargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <RootNamespace>GlobalConversationTracker.Engine</RootNamespace>
    <AssemblyName>GlobalConversationTracker.Engine</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <!--
      For SparseOrder. A NodeSet writes its entry ids as runs, which is the same
      encoding every file this repository writes uses, and it had a copy of its
      own - so the wire and the files could come to spell a run differently
      without anything noticing. One routine. Core is already compiled into the
      plugin beside this, so it costs no shipped dependency.
    -->
    <ProjectReference
      Include="..\GlobalConversationTracker.Core\GlobalConversationTracker.Core.csproj" />
  </ItemGroup>

  <!--
    The wire's types, generated from the same proto/engine.proto the Rust side
    generates from. That one file is the point of the whole arrangement: the shape
    that crosses used to be written twice, here by hand and there as serde types,
    and the two agreed only because someone remembered.

    Grpc.Tools carries a protoc and runs it at build time; PrivateAssets="all"
    keeps it out of anything that references this project, since it is a compiler
    rather than something the code calls. Google.Protobuf IS called at run time and
    is the one assembly that has to travel with the plugin - see the payload list in
    build-support.psm1, which had to learn about it because it is the first shipped
    file not named for this project.

    GrpcServices="None" because there is no service here. A .proto can describe
    calls as well as messages and the generator will write client and server stubs
    for them; the boundary is a length and a body over a pipe (de-bnjy.1), and
    nothing about that changes here - only what the body holds.
  -->
  <ItemGroup>
    <PackageReference Include="Google.Protobuf" Version="$(GoogleProtobufVersion)" />
    <PackageReference Include="Grpc.Tools" Version="$(GrpcToolsVersion)" PrivateAssets="all" />
    <Protobuf Include="$(MSBuildThisFileDirectory)..\..\proto\engine.proto"
      ProtoRoot="$(MSBuildThisFileDirectory)..\..\proto" GrpcServices="None" />
  </ItemGroup>

</Project>
