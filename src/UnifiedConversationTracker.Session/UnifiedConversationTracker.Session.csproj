<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!--
      net6.0 to match Persistence (and the CoreCLR runtime BepInEx v6 gives an
      IL2CPP plugin). This project is the layer that decides WHEN the unified
      state is read, seeded and written; it deliberately knows nothing about
      Unity, BepInEx or the Dialogue System, so it stays unit testable without
      the game. The plugin supplies the game-facing pieces.
    -->
    <TargetFramework>net6.0</TargetFramework>
    <!-- net6.0 is chosen to match the game's runtime, not for support status. -->
    <CheckEolTargetFramework>false</CheckEolTargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <RootNamespace>UnifiedConversationTracker.Session</RootNamespace>
    <AssemblyName>UnifiedConversationTracker.Session</AssemblyName>
  </PropertyGroup>


  <!--
    Location of the Disco Elysium - Final Cut install whose BepInEx installation
    supplies the reference assemblies. Override with either the DISCO_ELYSIUM_DIR
    environment variable or -p:DiscoElysiumDir=<path>.
  -->
  <PropertyGroup>
    <DiscoElysiumDir Condition="'$(DiscoElysiumDir)' == '' and '$(DISCO_ELYSIUM_DIR)' != ''">$(DISCO_ELYSIUM_DIR)</DiscoElysiumDir>
    <DiscoElysiumDir Condition="'$(DiscoElysiumDir)' == ''">$(MSBuildThisFileDirectory)..\..\Steam Install - Unaltered\Disco Elysium</DiscoElysiumDir>
    <BepInExCoreDir>$(DiscoElysiumDir)\BepInEx\core\</BepInExCoreDir>
  </PropertyGroup>

  <Target Name="ValidateBepInExReferenceDirs" BeforeTargets="BeforeBuild">
    <Error Condition="!Exists('$(BepInExCoreDir)')"
           Text="BepInEx core directory not found: $(BepInExCoreDir). Set DISCO_ELYSIUM_DIR or pass -p:DiscoElysiumDir=&lt;game dir&gt;." />
  </Target>

  <ItemGroup>
    <Reference Include="Il2CppInterop.Runtime" HintPath="$(BepInExCoreDir)Il2CppInterop.Runtime.dll" Private="false" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\UnifiedConversationTracker.Core\UnifiedConversationTracker.Core.csproj" />
    <ProjectReference Include="..\UnifiedConversationTracker.Persistence\UnifiedConversationTracker.Persistence.csproj" />
  </ItemGroup>

</Project>
