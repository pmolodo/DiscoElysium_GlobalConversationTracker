<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <RootNamespace>GlobalConversationTracker.LookAhead.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference
      Include="..\GlobalConversationTracker.LookAhead\GlobalConversationTracker.LookAhead.csproj" />
    <!--
      The offline crawler, so the suites that need no game can be checked here rather
      than in the harness. GameAutomation.Tests, where the in-game suites are declared,
      is net6.0-windows and cannot reference this net10.0 tool.
    -->
    <ProjectReference
      Include="..\..\tools\LookAheadOffline\LookAheadOffline.csproj" />
  </ItemGroup>

</Project>
