<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!--
      net6.0, deliberately, and NOT netstandard2.0 like the Core project.

      Core is netstandard2.0 with zero package references so it stays loadable
      from anywhere and testable without the game. This project needs a JSON
      serializer. System.Text.Json is in-box on net6.0 and a NuGet package (plus
      its System.Memory / System.Buffers dependency chain) on netstandard2.0.
      BepInEx v6 IL2CPP runs the plugin on net6.0 / CoreCLR, so targeting net6.0
      gets the serializer for free and ships no extra DLLs next to the plugin,
      while leaving Core's zero-dependency property intact.
    -->
    <TargetFramework>net6.0</TargetFramework>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- net6.0 is chosen to match the game's runtime, not for support status. -->
    <CheckEolTargetFramework>false</CheckEolTargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <RootNamespace>GlobalConversationTracker.Persistence</RootNamespace>
    <AssemblyName>GlobalConversationTracker.Persistence</AssemblyName>
  </PropertyGroup>

  <!--
    This project references assemblies out of a Disco Elysium install. Saying so
    here is the whole of it: Directory.Build.props resolves the install and
    Directory.Build.targets does the checking, for every project that needs one.
  -->
  <PropertyGroup>
    <NeedsBepInExCore>true</NeedsBepInExCore>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="Il2CppInterop.Runtime" HintPath="$(BepInExCoreDir)Il2CppInterop.Runtime.dll"
      Private="false" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference
      Include="..\GlobalConversationTracker.Core\GlobalConversationTracker.Core.csproj" />
  </ItemGroup>

  <!--
    The state file's one reader and writer, which is native.

    NOT OPTIONAL, unlike the engine host beside the plugin. That one is conditional on
    having been built, because a bridge that is not there costs a capability: the plugin
    logs it as unavailable and the game plays on. This is different in kind - it is how the
    mod reads and writes its own state, so a build without it is a build of a mod that
    cannot track anything. A missing library is therefore a build error naming the command,
    not a quiet omission discovered at runtime.

    Carried as content so it travels to everything that references this: the plugin, the
    tools and the tests all need it beside them.
  -->
  <PropertyGroup>
    <StateLibraryName>gct_state.dll</StateLibraryName>
    <StateLibraryRelease>$(MSBuildThisFileDirectory)..\..\target\release\$(StateLibraryName)</StateLibraryRelease>
    <StateLibraryDebug>$(MSBuildThisFileDirectory)..\..\target\debug\$(StateLibraryName)</StateLibraryDebug>
    <StateLibrary Condition="Exists('$(StateLibraryRelease)')">$(StateLibraryRelease)</StateLibrary>
    <StateLibrary
      Condition="'$(StateLibrary)' == '' And Exists('$(StateLibraryDebug)')">$(StateLibraryDebug)</StateLibrary>
  </PropertyGroup>

  <ItemGroup Condition="'$(StateLibrary)' != ''">
    <None Include="$(StateLibrary)" Link="$(StateLibraryName)">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <Target Name="RequireStateLibrary" BeforeTargets="Build" Condition="'$(StateLibrary)' == ''">
    <Error
      Text="The state library is not built, and it is what reads and writes the mod's own state file. Build it first:%0A  cargo build --release -p gct_state" />
  </Target>

  <ItemGroup>
    <!--
      The crash-point test seams (GlobalStateStore.SaveStepHook and
      WriteChunkSize) are internal so they stay out of the public API, but the
      unit tests, the out-of-process crash harness and the session tests all
      have to reach them.
    -->
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>GlobalConversationTracker.Persistence.Tests</_Parameter1>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>GlobalConversationTracker.Session.Tests</_Parameter1>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>GlobalConversationTracker.CrashHarness</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

</Project>
