{
    "[bat]": {
        "editor.formatOnSave": true,
        "editor.insertSpaces": true,
        "editor.tabSize": 4,
        "files.eol": "\r\n",
        "files.trimTrailingWhitespace": true
    },
    "[c][cpp][csharp][json][jsonc][shellscript][toml][yaml]": {
        "editor.formatOnSave": true,
        "editor.insertSpaces": true,
        "editor.tabSize": 4,
        "files.eol": "\n",
        "files.trimTrailingWhitespace": true
    },
    "[powershell]": {
        "editor.formatOnSave": true,
        "editor.insertSpaces": true,
        "editor.tabSize": 4,
        "files.eol": "\r\n",
        "files.trimTrailingWhitespace": true
    },
    "[python]": {
        "editor.codeActionsOnSave": {
            // generic actions - ruff is the only provider for both here
            "source.fixAll": "explicit",
            "source.organizeImports": "explicit"
        },
        // no generic equivalent - defaultFormatter takes an extension id.
        // Ruff's fixes run first via codeActionsOnSave, then black formats.
        "editor.defaultFormatter": "ms-python.black-formatter",
        "editor.formatOnSave": true,
        "editor.insertSpaces": true,
        "editor.rulers": [
            80,
            120
        ],
        "editor.tabSize": 4,
        "files.eol": "\n",
        "files.trimTrailingWhitespace": true
    },
    "[rust]": {
        // Named for the same reason python's is: defaultFormatter takes an extension id, so
        // there is no generic equivalent and a machine with a second Rust extension installed
        // would otherwise format by whichever one won. rust-analyzer shells out to the
        // toolchain's rustfmt, which reads rustfmt.toml at the repository root - so an editor
        // save and `cargo fmt` lay the code out the same way.
        "editor.defaultFormatter": "rust-lang.rust-analyzer",
        "editor.formatOnSave": true,
        "editor.insertSpaces": true,
        "editor.tabSize": 4,
        "files.eol": "\n",
        "files.trimTrailingWhitespace": true
    },
    "editor.wordWrapColumn": 120,
    "files.exclude": {
        "**/.DS_Store": true,
        "**/.git": true,
        "**/.hg": true,
        "**/.svn": true,
        "**/CVS": true
    },
    "python.analysis.typeCheckingMode": "off", // use ty for typing, not pylance
    "rewrap.wrappingColumn": 120
}
