<Project>

  <!--
    Keep every generated file under one gitignored .build\ folder at the repo
    root, instead of scattering bin\ and obj\ through src\. The PowerShell build
    scripts put their staging and dist folders there too.
  -->
  <PropertyGroup>
    <BuildRootDir>$(MSBuildThisFileDirectory).build\</BuildRootDir>
    <BaseOutputPath>$(BuildRootDir)bin\$(MSBuildProjectName)\</BaseOutputPath>
    <BaseIntermediateOutputPath>$(BuildRootDir)obj\$(MSBuildProjectName)\</BaseIntermediateOutputPath>
  </PropertyGroup>

  <!--
    Where the build reads its BepInEx and Il2CppInterop reference assemblies
    from. Three projects need them - Persistence, Session and the Plugin - and
    resolving it here rather than in each csproj means one order, one cache and
    one error message for all of them.

    Resolution order, first hit wins:

      1. -p:DiscoElysiumDir=<path>   (a command-line property beats anything set here)
      2. the DISCO_ELYSIUM_DIR environment variable
      3. <repo>\Steam Install - Unaltered\Disco Elysium, IF it is there
      4. the machine-level cache the PowerShell scripts write

    Step 3 is existence-checked on purpose. It is untracked, so it is present in
    a normal clone and absent in a git worktree; without the check the path
    would be taken anyway and step 4 could never run, which is exactly what used
    to make a bare 'dotnet build' fail in every agent worktree.

    Step 4 is what makes those worktrees work. The cache is per-user and lives
    outside the repo (see $RefDirCacheFile in build-support.psm1), so one
    .\provision-refs.ps1 or .\build.ps1 anywhere on the machine answers the
    question for every checkout on it, worktrees included.

    None of these values may be wrapped across lines: MSBuild trims only the
    ends of a property value, so a line break inside one lands in the middle of
    the path and every Exists() check on it then fails.
  -->
  <PropertyGroup>
    <RepoDefaultGameDir>$(MSBuildThisFileDirectory)Steam Install - Unaltered\Disco Elysium</RepoDefaultGameDir>
    <RefGameDirCacheFile Condition="'$(LOCALAPPDATA)' != ''">$(LOCALAPPDATA)\GlobalConversationTracker\reference-game-dir.txt</RefGameDirCacheFile>
  </PropertyGroup>

  <PropertyGroup>
    <DiscoElysiumDir Condition="'$(DiscoElysiumDir)' == '' and '$(DISCO_ELYSIUM_DIR)' != ''">$(DISCO_ELYSIUM_DIR)</DiscoElysiumDir>
    <DiscoElysiumDir Condition="'$(DiscoElysiumDir)' == '' and Exists('$(RepoDefaultGameDir)')">$(RepoDefaultGameDir)</DiscoElysiumDir>
    <DiscoElysiumDir Condition="'$(DiscoElysiumDir)' == '' and '$(RefGameDirCacheFile)' != '' and Exists('$(RefGameDirCacheFile)')">$([System.IO.File]::ReadAllText('$(RefGameDirCacheFile)').Trim())</DiscoElysiumDir>
    <BepInExCoreDir>$(DiscoElysiumDir)\BepInEx\core\</BepInExCoreDir>
    <BepInExInteropDir>$(DiscoElysiumDir)\BepInEx\interop\</BepInExInteropDir>
  </PropertyGroup>

</Project>
